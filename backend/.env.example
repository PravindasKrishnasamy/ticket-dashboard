# HTTP port the Express server binds to.
PORT=4000

NODE_ENV=development

# Comma-separated list of allowed origins for CORS (the frontend's URL).
CORS_ORIGIN=http://localhost:3000

# --- Database connection (used by src/config/db.js) ---
# Either provide a single connection string...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketflow
# ...or the individual fields below (DATABASE_URL takes precedence if set).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ticketflow

# Set to "true" when connecting to a Postgres instance that requires SSL
# (e.g. most managed RDS setups).
PGSSL=false
